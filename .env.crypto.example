OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# Crypto profile identity. These values are read independently by this service.
CONTENT_PROFILE=crypto
BOT_INSTANCE_ID=pankoff-crypto
CHANNEL_DISPLAY_NAME=PANKOFF CRYPTO
CHANNEL_SUBTITLE=Автопостинг крипто-новостей в Telegram
CHANNEL_SIGNATURE=@pankoff_crypto

# IMPORTANT: do not reuse the business bot DATABASE_URL or SESSION_SECRET.
DATABASE_URL=
SESSION_SECRET=

# A separate @BotFather bot that publishes only to the crypto channel.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=@pankoff_crypto
OWNER_TELEGRAM_ID=
REVIEW_CHAT_ID=

# Prefer a separate Telegram reader session so both services can reconnect safely.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_STRING_SESSION=

# Start in review mode. Enable AUTO_PUBLISH only after several successful tests.
SCHEDULE_ENABLED=false
AUTO_PUBLISH=false
POSTING_REQUIRES_APPROVAL=true

MIN_AUTO_POSTS_PER_DAY=6
MAX_AUTO_POSTS_PER_DAY=8
TARGET_AUTO_POSTS_PER_DAY=7

POSTING_TIMEZONE=Europe/Kyiv
POSTING_START_TIME=09:00
POSTING_END_TIME=23:30
NIGHT_PAUSE_ENABLED=true
NIGHT_PAUSE_START=00:00
NIGHT_PAUSE_END=08:30

MIN_MINUTES_BETWEEN_POSTS=75
MAX_MINUTES_BETWEEN_POSTS=180
POSTING_RANDOM_DELAY_ENABLED=true
POSTING_RANDOM_DELAY_MINUTES=25
AUTO_PUBLISH_MIN_CONFIDENCE=medium

MAX_POSTS_PER_DAY=8
MIN_POSTS_PER_DAY=6
MAX_AI_CALLS_PER_DAY=50
MAX_REWRITE_PER_POST=1
MAX_TOKENS_PER_POST=1100
MAX_SOURCE_POSTS_PER_CHANNEL=20
LOOKBACK_HOURS=24
MAX_SOURCE_AGE_HOURS=24

ENABLE_SECONDARY_SOURCES=false
MAX_SECONDARY_SOURCES=3
ENABLE_MEDIA_DOWNLOAD=true
ENABLE_COST_GUARD=true
ENABLE_AI_QUALITY_CHECK=true
QUALITY_CHECK_MIN_SCORE=90
MAX_AUTO_QUALITY_REWRITES=1

TELEGRAM_CUSTOM_EMOJI_ENABLED=true
TELEGRAM_CUSTOM_EMOJI_FALLBACK=true
